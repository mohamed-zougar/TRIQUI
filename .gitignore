# ============================================================
logs/
*.log
npm-debug.log*
npm-error.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ============================================================
# TESTING & COVERAGE
# ============================================================
coverage/
.nyc_output/
.jest-cache/
.mocha_output/

